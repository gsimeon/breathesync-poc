{
  "name": "breathesync",
  "version": "0.1.0",
  "private": true,
  "description": "BreatheSync SmartSpectra desktop proof of concept",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test test/**/*.test.mjs",
    "test": "npm run typecheck && npm run test:unit",
    "package:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "^3.4.0",
    "dotenv": "^16.4.7",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.breathesync.desktop",
    "productName": "BreatheSync",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "**/node_modules/@smartspectra/**",
      "**/node_modules/koffi/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}